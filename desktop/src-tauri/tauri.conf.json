{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIB Trader",
  "version": "0.1.0",
  "identifier": "com.maxchea.mibtrader",
  "build": {
    "frontendDist": "../../frontend/build",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "MIB Trader",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "MIB Trader"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mib-backend"]
  }
}
